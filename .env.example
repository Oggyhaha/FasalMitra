# FasalMitra Environment Configuration Example
# Copy this file to .env and fill in your actual credentials

PROJECT_NAME=FasalMitra
VERSION=1.0.0
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/KishanMitra_db
SUPABASE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

DATA_GOV_IN_API_KEY=YOUR_DATA_GOV_IN_API_KEY

# AI & Channel Credentials (Optional - Pluggable Mock Fallbacks Active by Default)
GEMINI_API_KEY=
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WEATHER_API_KEY=
INDIC_TRANS2_ENDPOINT=

USE_MOCK_FALLBACK=true
